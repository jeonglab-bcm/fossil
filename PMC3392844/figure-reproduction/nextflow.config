params {
    outdir = 'results'
    python = 'python3'
    sources = null
    extract = false
    full = false
    cpus = 4
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    PYTHONHASHSEED = '0'
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    // OpenBLAS picks CPU-specific kernels at run time; LIBLINEAR's solver (LR) calls them, and with the
    // paper's epsilon of 1 a last-bit difference moves where it stops. Haswell (AVX2) runs on every x86
    // runner, so the run gives the same numbers on Intel and AMD machines.
    OPENBLAS_CORETYPE = 'Haswell'
}
