params {
    outdir = 'results'
    python = 'python3'
    sources = null
    jobs = 4
    update = false
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // The experiments run one process per repeat; keep each single-threaded so runs are repeatable.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    NUMBA_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
}
