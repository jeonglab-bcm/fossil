params {
    outdir = 'results'
    python = 'python3'
    sources = null
    studies = false
    boot = 500
    seed = 0
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
}

profiles {
    // Skyriver (BCM): the Nextflow head runs inside a Slurm job (run_skyriver.sbatch), and every
    // process is its own Slurm job, never on the login node.
    skyriver {
        process {
            executor = 'slurm'
            queue = 'defq15'
            time = '4h'
            cpus = 4
            memory = '16 GB'
        }
        executor {
            queueSize = 20
        }
    }
}
