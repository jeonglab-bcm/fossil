params {
    outdir = 'results'
    python = 'python3'
    sources = null
    full = false
    port_check = false
    rscript = 'Rscript'
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One thread per process: the forests are single-threaded, and the replicates run as separate
    // tasks. Numba caches its compiled code per task folder.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    NUMBA_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
}

profiles {
    // Skyriver (BCM): run the Nextflow head inside a Slurm job (run_skyriver.sbatch); every process
    // is a separate Slurm job, never on the login node.
    skyriver {
        process {
            executor = 'slurm'
            queue = 'defq15'
            time = '8h'
            memory = '4 GB'
        }
        executor {
            queueSize = 150
        }
    }
}
