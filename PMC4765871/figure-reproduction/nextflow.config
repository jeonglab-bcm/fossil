params {
    outdir = 'results'
    python = 'python3'
    sources = null
    full = false
    cpus = 4
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    // portable machine code for the compiled sampler (no host-specific instructions)
    NUMBA_CPU_NAME = 'generic'
    // the same OpenBLAS kernels on every x86-64 machine (the cluster and GitHub's runners)
    OPENBLAS_CORETYPE = 'Haswell'
}

profiles {
    // Skyriver (BCM): run the Nextflow head inside a Slurm job (run_skyriver.sbatch); each process
    // is a separate Slurm job on defq15, never on the login node.
    skyriver {
        params.cpus = 48
        process {
            executor = 'slurm'
            queue = 'defq15'
            time = '4h'
            memory = '32 GB'
        }
    }
}
