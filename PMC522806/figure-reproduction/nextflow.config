params {
    outdir = 'results'
    python = 'python3'
    sources = null
    full = false
    jobs = 4
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One BLAS thread per worker: the network fits are then the same on every runner.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
}
