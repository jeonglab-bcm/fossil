params {
    outdir = 'results'
    python = 'python3'
    sources = null
    full = false
    jobs = 4
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One BLAS thread per worker: the network fits are then the same on every runner.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
    // The same arithmetic on every x86 CPU: NumPy's AVX-512 loops off and OpenBLAS's Haswell (AVX2)
    // kernels, whatever the runner's CPU. Without this, a runner without AVX-512 moves the
    // confidences by up to 3e-5 (and a class near 0.5 could flip). The committed outputs were
    // made with these settings.
    NPY_DISABLE_CPU_FEATURES = 'AVX512F AVX512CD AVX512_SKX AVX512_CLX AVX512_CNL AVX512_ICL AVX512_SPR'
    OPENBLAS_CORETYPE = 'Haswell'
}
