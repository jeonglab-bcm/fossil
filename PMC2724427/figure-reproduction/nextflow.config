params {
    outdir = 'results'
    python = 'python3'
    sources = null
    full = false
    jobs = 4
    seed = 2724427
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One BLAS thread per process; the figures in a UTF-8 locale.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    LC_ALL = 'C.UTF-8'
}
