\name{pvalue_density_filtered}
\alias{pvalue_density_filtered}
\title{P-value density of the t test after filtering}
\usage{
pvalue_density_filtered(u, nu = 8, delta = 0, filter = c("none", "foldchange", "variance"), removed = 0.25, threshold = c("null", "own"))
}
\arguments{
\item{u}{p-values at which to evaluate the density (in (0, 1)).}
\item{nu}{degrees of freedom (n per group is \code{nu/2 + 1}).}
\item{delta}{noncentrality of the t statistic under the alternative (0 for the null): the group difference is \code{delta * sqrt(2 / n)}.}
\item{filter}{\code{"none"}, \code{"foldchange"}, \code{"variance"} or \code{"total_variance"}.}
\item{removed}{fraction of the features removed.}
\item{threshold}{\code{"null"}: the threshold removes the fraction \code{removed} of the null features and is used under both hypotheses; \code{"own"}: it removes that fraction under the hypothesis evaluated.}
}
\value{
