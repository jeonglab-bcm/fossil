params {
    outdir = 'results'
    python = 'python3'
    rscript = 'Rscript'
    sources = null
    full = false
    variants = false
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One thread per process: the forests are single-threaded; the full study runs as many tasks.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
    LC_ALL = 'C.UTF-8'
}
