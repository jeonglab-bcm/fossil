      ]
    },
    {
      "text": "The pathway model B is more detailed than pathway model A and accounts for the protein ampliﬁcation cascade",
      "bbox": [
        48.18916320800781,
        759.240966796875,
        547.1262817382812,
        768.0877685546875
      ],
      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "from TrkA to Erk via Ras, Raf and Mek.",
      "bbox": [
        48.18916320800781,
        771.1969604492188,
