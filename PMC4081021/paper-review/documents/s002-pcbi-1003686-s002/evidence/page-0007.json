      "direction": [
        1.0,
        0.0
      ]
    },
    {
      "text": "k = (k1, k2, k4, k5, k7, k9, k11, k3[TrkA]0, k6[Ras]0, k8[Raf]0, k10[Mek]0, s[Erk]0, sK3, n).",
      "bbox": [
