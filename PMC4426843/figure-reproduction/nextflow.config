params {
    outdir = 'results'
    python = 'python3'
    rscript = 'Rscript'
    miranda = 'miranda'
    sources = null
    full = false
    rerun = 'all'
    iterations = 999999
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder. Scripts write to their working directory; a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

profiles {
    // Skyriver (BCM) cluster: run the Nextflow head inside a Slurm job (see run_skyriver.sbatch);
    // each task is submitted to defq15, never run on the login node.
    skyriver {
        process {
            executor = 'slurm'
            queue = 'defq15'
            time = '2h'
            memory = '8 GB'
            withName: EMPIRICAL { cpus = 8; memory = '24 GB' }
            withName: UTRS { memory = '16 GB' }
            withName: MIRANDA { time = '4h' }
        }
        executor.queueSize = 60
    }
}
