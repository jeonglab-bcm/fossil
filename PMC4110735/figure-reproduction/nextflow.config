params {
    outdir = 'results'
    python = 'python3'
    rscript = 'Rscript'
    sources = null
    timing = false
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One thread per process, so results and run times do not depend on how tasks share the machine.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
}
