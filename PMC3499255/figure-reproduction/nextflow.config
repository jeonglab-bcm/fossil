params {
    outdir = 'results'
    python = 'python3'
    sources = null
    full = false
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory,
    // and a symlinked input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // Deterministic, single-threaded: the MCMC uses numpy's PCG64 with a fixed seed.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
}
