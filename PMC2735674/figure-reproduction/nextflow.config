params {
    outdir = 'results'
    sources = null
    full = false
    cpus = 4
    skip_package = false
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One thread per process: the score step runs its own pool, and the local SVM fits are small.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    // The same OpenBLAS kernels on every x86-64 machine (the cluster and GitHub's runners).
    OPENBLAS_CORETYPE = 'Haswell'
}

profiles {
    // Skyriver (BCM): the Nextflow head runs inside a Slurm job (run_skyriver_pipeline.sbatch) and
    // every process is its own Slurm job on defq15, never on the login node.
    skyriver {
        params.cpus = 16
        process {
            executor = 'slurm'
            queue = 'defq15'
            time = '8h'
            memory = '32 GB'
            cpus = 1
            withName: SCORES {
                cpus = 16
                memory = '64 GB'
            }
        }
    }
}
