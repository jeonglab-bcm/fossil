params {
    outdir = 'results'
    python = 'python3'
    rscript = 'Rscript'
    sources = null
    full = false
    cpus = 4
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One BLAS thread, so sums come out the same on every runner.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    LANG = 'C.UTF-8'
    LC_ALL = 'C.UTF-8'
}
