params {
    outdir = 'results'
    python = 'python3'
    java = 'java'
    mcl = 'mcl'
    sources = null
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One BLAS thread per process: the walks are sparse matrix-vector products, and many BLAS
    // threads on a few cores slow the dense solves of the package tests by orders of magnitude.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
}

profiles {
    // Skyriver (BCM): run the Nextflow head inside a Slurm job (run_skyriver.sbatch); every process
    // is a separate Slurm job, never on the login node.
    skyriver {
        process {
            executor = 'slurm'
            queue = 'defq15'
            time = '2h'
            memory = '16 GB'
            cpus = 2
        }
        executor {
            queueSize = 20
        }
    }
}
