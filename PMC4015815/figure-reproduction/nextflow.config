params {
    outdir = 'results'
    python = 'python3'
    sources = null
    dmax = '0,10,20,40,50,60,80,100,150,200'
    profiles = false
    workers = 4
    seed = 1
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a
    // symlinked input could be overwritten in the repository.
    stageInMode = 'copy'
    withName: WEIGHTS { memory = '4 GB' }
}
