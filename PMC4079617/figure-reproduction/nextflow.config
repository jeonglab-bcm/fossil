params {
    outdir = 'results'
    python = 'python3'
    sources = null
    jobs = 0
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    PYTHONHASHSEED = '0'
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    // The same arithmetic on every x86-64 machine: OpenBLAS's Haswell (AVX2) kernels and no AVX-512 paths in
    // NumPy, so a run on an AVX-512 machine gives the committed numbers bit for bit on an AVX2 CI runner.
    OPENBLAS_CORETYPE = 'Haswell'
    NPY_DISABLE_CPU_FEATURES = 'AVX512F AVX512CD AVX512_KNL AVX512_KNM AVX512_SKX AVX512_CLX AVX512_CNL AVX512_ICL AVX512_SPR'
    MPLBACKEND = 'Agg'
}
