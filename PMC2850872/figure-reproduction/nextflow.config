params {
    outdir = 'results'
    python = 'python3'
    rscript = 'Rscript'
    sources = null
    search = false
    reps = 10
    jobs = 4
}

// One OpenBLAS kernel on every machine. scikit-learn's LIBSVM and the logistic regression call BLAS;
// its AVX-512 kernel (SkylakeX) and its AVX2 kernel (Haswell, also used on AMD Zen) round
// differently, which moves single-split AUCs by up to 0.004 and the median DeLong P by 8e-4.
// Haswell runs on any x86-64 CPU with AVX2, including every GitHub-hosted runner.
env {
    OPENBLAS_CORETYPE = 'Haswell'
}

process {
    errorStrategy = 'terminate'
    stageInMode = 'copy'
}
