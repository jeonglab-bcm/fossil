params {
    outdir = 'results'
    python = 'python3'
    sources = null
    full = false
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One thread per process: LIBSVM is single-threaded, and NumPy's BLAS threads would only add
    // run-to-run noise in the last bits.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
}

profiles {
    // Skyriver (BCM): run the Nextflow head inside a Slurm job (run_skyriver.sbatch); every process
    // is a separate Slurm job, never on the login node.
    skyriver {
        process {
            executor = 'slurm'
            queue = 'debugq'
            time = '8h'
            memory = '8 GB'
        }
        executor {
            queueSize = 60
        }
    }
}
