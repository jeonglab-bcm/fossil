params {
    outdir = 'results'
    python = 'python3'
    octave = 'octave-cli'
    sources = null
    full = false
    octave_check = false
    seeds = 20
    cpus = 4
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a
    // symlinked input could otherwise be overwritten in the repository.
    stageInMode = 'copy'
}

profiles {
    // Skyriver (BCM) cluster: run the Nextflow head inside a Slurm job (run_skyriver.sbatch);
    // each task goes to defq15, never the login node.
    skyriver {
        process {
            executor = 'slurm'
            queue = 'defq15'
            time = '2h'
            memory = '16 GB'
            cpus = 8
        }
        executor.queueSize = 20
    }
}
