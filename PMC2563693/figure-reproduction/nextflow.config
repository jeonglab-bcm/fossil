params {
    outdir = 'results'
    python = 'python3'
    sources = null
    full = false
    check_repeats = 2
}

process {
    errorStrategy = 'terminate'
    // Copy inputs into each task folder: scripts write to their working directory, and a symlinked
    // input could be overwritten in the repository.
    stageInMode = 'copy'
}

env {
    // One thread per process: each task is single-threaded, and the repeats run as separate tasks.
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    PYTHONHASHSEED = '0'
    MPLBACKEND = 'Agg'
}

profiles {
    // Skyriver (BCM): run the Nextflow head inside a Slurm job (run_skyriver.sbatch); every process
    // is a separate Slurm job, never on the login node.
    skyriver {
        process {
            executor = 'slurm'
            queue = 'defq15'
            time = '4h'
            memory = '6 GB'
        }
        executor {
            queueSize = 120
        }
    }
}
